// Email Auto Responder - Prisma schema
// Multi-tenant SaaS. Vector search via pgvector (voyage-3.5, 1024 dims).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  owner
  admin
  member
}

enum MailboxStatus {
  connected
  expired
  revoked
}

enum ReplyMode {
  draft_only
  auto_send
}

enum MessageDirection {
  inbound
  outbound
}

enum DraftStatus {
  pending
  approved
  sent
  rejected
  auto_sent
}

enum TrustedSenderStatus {
  trusted
  blocked
}

enum NotificationChannel {
  whatsapp
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  plan      String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  mailboxes         Mailbox[]
  threads           Thread[]
  messages          Message[]
  drafts            Draft[]
  trustedSenders    TrustedSender[]
  notifications     Notification[]
  messageEmbeddings MessageEmbedding[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           UserRole @default(member)
  email          String   @unique
  name           String?
  avatarUrl      String?  @map("avatar_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxes    Mailbox[]

  @@index([organizationId])
  @@map("users")
}

model Mailbox {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  msUserId              String?       @map("ms_user_id")
  msTenantId            String?       @map("ms_tenant_id")
  emailAddress          String        @map("email_address")
  displayName           String?       @map("display_name")
  accessTokenEnc        String?       @map("access_token_enc")
  refreshTokenEnc       String?       @map("refresh_token_enc")
  tokenExpiresAt        DateTime?     @map("token_expires_at")
  subscriptionId        String?       @map("subscription_id")
  subscriptionExpiresAt DateTime?     @map("subscription_expires_at")
  status                MailboxStatus @default(connected)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules          ReplyRule[]
  threads        Thread[]
  messages       Message[]
  drafts         Draft[]
  trustedSenders TrustedSender[]
  embeddings     MessageEmbedding[]

  @@unique([organizationId, emailAddress])
  @@index([organizationId])
  @@map("mailboxes")
}

model ReplyRule {
  id         String    @id @default(uuid()) @db.Uuid
  mailboxId  String    @map("mailbox_id") @db.Uuid
  mode       ReplyMode @default(draft_only)
  conditions Json      @default("{}")
  tone       String?
  signature  String?
  language   String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([mailboxId])
  @@map("reply_rules")
}

model Thread {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  mailboxId        String    @map("mailbox_id") @db.Uuid
  msConversationId String    @map("ms_conversation_id")
  subject          String?
  participants     Json      @default("[]")
  lastMessageAt    DateTime? @map("last_message_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailbox      Mailbox            @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messages     Message[]
  drafts       Draft[]
  embeddings   MessageEmbedding[]

  @@unique([mailboxId, msConversationId])
  @@index([organizationId])
  @@map("threads")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  threadId          String           @map("thread_id") @db.Uuid
  mailboxId         String           @map("mailbox_id") @db.Uuid
  msMessageId       String           @map("ms_message_id")
  internetMessageId String?          @map("internet_message_id")
  direction         MessageDirection
  from              Json
  to                Json             @default("[]")
  cc                Json             @default("[]")
  subject           String?
  bodyText          String?          @map("body_text")
  bodyHtml          String?          @map("body_html")
  receivedAt        DateTime?        @map("received_at")
  sentAt            DateTime?        @map("sent_at")
  isProcessed       Boolean          @default(false) @map("is_processed")
  createdAt         DateTime         @default(now()) @map("created_at")

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread          Thread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mailbox         Mailbox            @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  embeddings      MessageEmbedding[]
  triggeredDrafts Draft[]            @relation("DraftTrigger")

  @@unique([mailboxId, msMessageId])
  @@index([organizationId])
  @@index([threadId])
  @@map("messages")
}

model MessageEmbedding {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  mailboxId      String                       @map("mailbox_id") @db.Uuid
  threadId       String                       @map("thread_id") @db.Uuid
  messageId      String                       @map("message_id") @db.Uuid
  chunkIndex     Int                          @map("chunk_index")
  content        String
  embedding      Unsupported("vector(1024)")?
  createdAt      DateTime                     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailbox      Mailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  thread       Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, mailboxId])
  @@index([threadId])
  @@map("message_embeddings")
}

model Draft {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  mailboxId        String      @map("mailbox_id") @db.Uuid
  threadId         String      @map("thread_id") @db.Uuid
  triggerMessageId String      @map("trigger_message_id") @db.Uuid
  generatedSubject String?     @map("generated_subject")
  generatedBody    String?     @map("generated_body")
  status           DraftStatus @default(pending)
  msDraftId        String?     @map("ms_draft_id")
  modelMeta        Json        @default("{}") @map("model_meta")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailbox        Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  thread         Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  triggerMessage Message        @relation("DraftTrigger", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([organizationId])
  @@index([threadId])
  @@map("drafts")
}

model TrustedSender {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  mailboxId      String              @map("mailbox_id") @db.Uuid
  senderAddress  String              @map("sender_address")
  status         TrustedSenderStatus @default(trusted)
  approvedBy     String?             @map("approved_by") @db.Uuid
  approvedAt     DateTime?           @map("approved_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailbox      Mailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, senderAddress])
  @@index([organizationId])
  @@map("trusted_senders")
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  draftId           String?             @map("draft_id") @db.Uuid
  channel           NotificationChannel @default(whatsapp)
  payload           Json                @default("{}")
  status            String              @default("pending")
  providerMessageId String?             @map("provider_message_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft        Draft?       @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actor          String?
  action         String
  entity         String?
  entityId       String?  @map("entity_id")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("audit_logs")
}
