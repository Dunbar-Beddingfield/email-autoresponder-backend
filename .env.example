# ------------------------------------------------------------------
# Email Auto Responder - Backend environment variables (example)
# Copy to .env and fill in real values. Never commit the real .env.
# ------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000

# Database (must match docker-compose for local dev)
POSTGRES_USER=ear
POSTGRES_PASSWORD=ear_dev_password
POSTGRES_DB=ear_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ear:ear_dev_password@localhost:5432/ear_dev?schema=public

# Redis (BullMQ + cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Security
# 32-byte key (base64/hex) used to encrypt Microsoft Graph tokens at rest
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_random_key
SESSION_SECRET=replace_with_random_secret

# Microsoft Graph (multi-tenant app, delegated permissions)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback
GRAPH_WEBHOOK_CLIENT_STATE=replace_with_random_secret
GRAPH_WEBHOOK_NOTIFICATION_URL=https://your-public-host/webhooks/graph

# AI generation - Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Embeddings - Voyage AI (voyage-3.5, 1024 dims)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
VOYAGE_EMBED_DIM=1024

# WhatsApp - Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=replace_with_random_secret

# Auto-send behavior
AUTO_SEND_CONFIDENCE_THRESHOLD=0.75
